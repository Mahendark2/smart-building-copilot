# Copy this file to .env and pick ONE of the three LLM options.

# Option 1 (easiest): Google Gemini, free key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=

# Option 2 (no key, runs on your computer, needs about 4 GB of free RAM):
#   LLM_PROVIDER=ollama
#   leave LLM_API_KEY empty
#   start with: docker compose --profile local-llm up --build

# Option 3: OpenAI (paid)
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...

# Optional: pick the model. Leave empty for the provider's default.
# You can list several, separated by commas: if one is busy (Google's
# "high demand" error) the next one is tried. It must support tool calling.
# Gemini default: gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest
LLM_MODEL=

# Which zones get which fault: stuck_damper, sensor_drift, fan_off, high_co2
FAULTS=3:stuck_damper,5:sensor_drift

# Port the dashboard is served on: http://localhost:8080
PORT=8080
