# Copy to .env and fill in. Any OpenAI-compatible provider works.
LLM_API_KEY=
# Leave blank for OpenAI. Examples: https://api.groq.com/openai/v1, http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Which zones get which fault: stuck_damper, sensor_drift, fan_off, high_co2
FAULTS=3:stuck_damper,5:sensor_drift

# Port the dashboard is served on
PORT=8080
